{
  "name": "trpc-monorepo",
  "private": true,
  "scripts": {
    "build": "dotenv -e .env.local -- turbo build",
    "dev": "dotenv -e .env.local -- turbo dev",
    "db:generate": "dotenv -e .env.local -- turbo db:generate",
    "db:migrate": "dotenv -e .env.local -- turbo db:migrate",
    "db:seed": "dotenv -e .env.local -- pnpm --filter @repo/database db:seed",
    "db:studio": "dotenv -e .env.local -- pnpm --filter @repo/database db:studio",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv-cli": "^11.0.0"
  }
}
