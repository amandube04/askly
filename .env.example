# Copy this file to `.env.local` (gitignored) and fill in real values.
# `pnpm dev` at repo root reads `.env.local` via `dotenv -e .env.local`.

# ── Database (required) ──
DATABASE_URL=postgresql://USER@localhost:5432/dev

# ── API + Web base URLs ──
BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# ── Google OAuth (optional in dev — demo login button works without these) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Resend (optional — email notifications quietly no-op when missing) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
